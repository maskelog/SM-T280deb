diff --git a/src/native-state-fbdev.cpp b/src/native-state-fbdev.cpp
new file mode 100644
index 0000000..13da659
--- /dev/null
+++ b/src/native-state-fbdev.cpp
@@ -0,0 +1,76 @@
+/* fbdev native state for the ARM Mali Utgard fbdev EGL (SM-T280 port). */
+#include "native-state-fbdev.h"
+#include "log.h"
+
+#include <fcntl.h>
+#include <linux/fb.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+bool
+NativeStateFbdev::init_display()
+{
+    int fd = open("/dev/fb0", O_RDONLY);
+    struct fb_var_screeninfo var;
+    if (fd < 0 || ioctl(fd, FBIOGET_VSCREENINFO, &var) < 0) {
+        Log::error("Cannot query /dev/fb0\n");
+        if (fd >= 0)
+            close(fd);
+        return false;
+    }
+    close(fd);
+    fb_width_ = var.xres;
+    fb_height_ = var.yres;
+    signal(SIGINT, &NativeStateFbdev::quit_handler);
+    return true;
+}
+
+void*
+NativeStateFbdev::display()
+{
+    return nullptr;
+}
+
+bool
+NativeStateFbdev::create_window(WindowProperties const& properties)
+{
+    properties_ = properties;
+    if (properties_.fullscreen || properties_.width <= 0 || properties_.height <= 0) {
+        properties_.width = fb_width_;
+        properties_.height = fb_height_;
+    }
+    fbwin_.width = properties_.width;
+    fbwin_.height = properties_.height;
+    return true;
+}
+
+void*
+NativeStateFbdev::window(WindowProperties& properties)
+{
+    properties = properties_;
+    return &fbwin_;
+}
+
+void
+NativeStateFbdev::visible(bool /*v*/)
+{
+}
+
+volatile std::sig_atomic_t NativeStateFbdev::should_quit_(false);
+
+void
+NativeStateFbdev::quit_handler(int /*signo*/)
+{
+    should_quit_ = true;
+}
+
+bool
+NativeStateFbdev::should_quit()
+{
+    return should_quit_;
+}
+
+void
+NativeStateFbdev::flip()
+{
+}
diff --git a/src/native-state-fbdev.h b/src/native-state-fbdev.h
new file mode 100644
index 0000000..a23f41b
--- /dev/null
+++ b/src/native-state-fbdev.h
@@ -0,0 +1,29 @@
+/* fbdev native state for the ARM Mali Utgard fbdev EGL (SM-T280 port). */
+#ifndef GLMARK2_NATIVE_STATE_FBDEV_H_
+#define GLMARK2_NATIVE_STATE_FBDEV_H_
+
+#include "native-state.h"
+#include <csignal>
+
+class NativeStateFbdev : public NativeState
+{
+public:
+    bool init_display() override;
+    void* display() override;
+    bool create_window(WindowProperties const& properties) override;
+    void* window(WindowProperties& properties) override;
+    void visible(bool v) override;
+    bool should_quit() override;
+    void flip() override;
+
+private:
+    static void quit_handler(int signum);
+    static volatile std::sig_atomic_t should_quit_;
+
+    struct { unsigned short width, height; } fbwin_ {0, 0};
+    int fb_width_ {0};
+    int fb_height_ {0};
+    WindowProperties properties_;
+};
+
+#endif
