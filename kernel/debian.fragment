# Debian 13 (armhf, sysvinit) on the vendor 3.10 kernel.
# udev needs devtmpfs and name_to_handle_at().
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
# Android-only: restricts AF_INET sockets to gid 3003, which breaks normal users.
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# Use the bootloader cmdline as is (no androidboot.* arguments).
CONFIG_CMDLINE_FROM_BOOTLOADER=y
# CONFIG_CMDLINE_EXTEND is not set
# Bluetooth: SC2331 (Marlin) BT core on UART0, H4 (see rootfs/files/bluetooth)
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_UHID=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
