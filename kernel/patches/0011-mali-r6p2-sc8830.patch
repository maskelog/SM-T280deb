+	down(gpu_dfs_ctx.sem);
+	MALI_DEBUG_PRINT(3,("Mali power mode change %d, gpu_power_on=%d gpu_clock_on=%d\n",
+	    power_mode,gpu_dfs_ctx.gpu_power_on,gpu_dfs_ctx.gpu_clock_on));
+	switch(power_mode)
+	{
