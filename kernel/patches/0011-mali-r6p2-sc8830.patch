+	of_property_read_u32(np, "freq-5-overclk", &i);
+	gpu_dfs_ctx.freq_5 = &gpu_dfs_ctx.freq_list[i];
+	MALI_DEBUG_ASSERT(gpu_dfs_ctx.freq_5);
