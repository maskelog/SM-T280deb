 static _mali_mem_validation_t mali_mem_validator = { MALI_INVALID_MEM_ADDR, MALI_INVALID_MEM_ADDR };
 
+#ifdef CONFIG_MALI_PLATFORM_SC8830
+#include <linux/fb.h>
+/*
+ * sc8830: sprdfb registers after Mali probes, so no frame buffer range is
+ * known at init time. Install the range of fb0 lazily on first use, so the
+ * fbdev EGL can bind the frame buffer while other physical memory stays
+ * rejected.
+ */
+static void mali_mem_validation_add_fb0(void)
+{
+	struct fb_info *info;
+	u32 start, end;
+
+	if (MALI_INVALID_MEM_ADDR != mali_mem_validator.phys_base || num_registered_fb < 1)
+		return;
+	info = registered_fb[0];
+	if (NULL == info || 0 == info->fix.smem_len)
+		return;
+	start = info->fix.smem_start & _MALI_OSK_CPU_PAGE_MASK;
+	end = PAGE_ALIGN(info->fix.smem_start + info->fix.smem_len);
+	mali_mem_validation_add_range(start, end - start);
+}
+#endif
+
 _mali_osk_errcode_t mali_mem_validation_add_range(u32 start, u32 size)
 {
 	/* Check that no other MEM_VALIDATION resources exist */
@@ -46,6 +70,9 @@
 
 _mali_osk_errcode_t mali_mem_validation_check(u32 phys_addr, u32 size)
 {
+#ifdef CONFIG_MALI_PLATFORM_SC8830
+	mali_mem_validation_add_fb0();
+#endif
 	if (phys_addr < (phys_addr + size)) { /* Don't allow overflow (or zero size) */
 		if ((0 == (phys_addr & (~_MALI_OSK_CPU_PAGE_MASK))) &&
 		    (0 == (size & (~_MALI_OSK_CPU_PAGE_MASK)))) {
