+		{
+			mali_clock_on();
+		}
+		break;
+
+	//MALI_POWER_MODE_LIGHT_SLEEP
+	case 1:
+		if(gpu_dfs_ctx.gpu_clock_on)
+		{
+			mali_clock_off();
+		}
+
+		if(gpu_dfs_ctx.gpu_power_on)
+		{
+			mali_power_off();
+		}
+		break;
+
+	//MALI_POWER_MODE_DEEP_SLEEP
+	case 2:
+		if(gpu_dfs_ctx.gpu_clock_on)
+		{
+			mali_clock_off();
+		}
+
+		if(gpu_dfs_ctx.gpu_power_on)
+		{
+			mali_power_off();
+		}
+		break;
+	};
+	up(gpu_dfs_ctx.sem);
+#endif
+}
