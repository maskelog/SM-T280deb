+	gpu_dfs_ctx.freq_range_max = &gpu_dfs_ctx.freq_list[i];
+	MALI_DEBUG_ASSERT(gpu_dfs_ctx.freq_range_max);
+
+	of_property_read_u32(np, "freq-range-min-overclk", &i);
+	gpu_dfs_ctx.freq_range_min = &gpu_dfs_ctx.freq_list[i];
