+	of_property_read_u32(np, "freq-list-len", &gpu_dfs_ctx.freq_list_len);
+	gpu_dfs_ctx.freq_list = vmalloc(sizeof(struct gpu_freq_info) * gpu_dfs_ctx.freq_list_len);
